{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zanweis-playground",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/presence/*", "/assets/video/*.webm"]
  },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "VideoAsset": { "type": "worker", "cache": { "enabled": true } }
  },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }]
}
